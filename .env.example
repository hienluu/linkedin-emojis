# Copy to .env for local development:   cp .env.example .env
# Then check it with:                   uv run config.py
#
# LOCAL DEVELOPMENT ONLY. .env is excluded from git, the Docker image and the
# Cloud Build upload. Deployments get these from a Modal secret or from GCP
# Secret Manager — see the Deploy section of README.md.
#
# A real environment variable always beats a value set here, so this file can
# never shadow a production secret.
#
# ALL OPTIONAL. With none of it set the app still runs: emoji search and
# rule-based post composing work, and only the LLM placement mode is disabled.

# --- the three that configure the LLM -----------------------------------------
# Any OpenAI-compatible provider. LLM_MODEL is required if you set either other.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- tuning (rarely needed) ----------------------------------------------------
# LLM_TIMEOUT=60          # seconds per request
# LLM_MAX_RETRIES=2
# LLM_TEMPERATURE=0.4     # 0 = most predictable placement

# ------------------------------------------------------------------------------
# Endpoints and a sensible model for common providers — copy one into the values
# above. Omit LLM_BASE_URL entirely for OpenAI.
#
#   OpenAI       (leave LLM_BASE_URL empty)                gpt-4o-mini
#   Gemini       https://generativelanguage.googleapis.com/v1beta/openai/
#                                                          gemini-3.5-flash-lite
#   Groq         https://api.groq.com/openai/v1            llama-3.3-70b-versatile
#   Together     https://api.together.xyz/v1               meta-llama/Llama-3.3-70B-Instruct-Turbo
#   OpenRouter   https://openrouter.ai/api/v1              google/gemini-2.5-flash-lite
#   DeepSeek     https://api.deepseek.com                  deepseek-chat
#   Fireworks    https://api.fireworks.ai/inference/v1     accounts/fireworks/models/llama-v3p3-70b-instruct
#   Ollama       http://localhost:11434/v1                 llama3.2   (leave LLM_API_KEY empty)
#
# Example — Groq:
#   LLM_API_KEY=gsk-...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
